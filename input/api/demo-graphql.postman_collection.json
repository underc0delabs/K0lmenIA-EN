{
  "info": {
    "name": "Demo GraphQL k0lmenIA (Countries)",
    "description": "Sample GraphQL collection for Newman. It points to https://countries.trevorblades.com (public GraphQL API, no login). The requests use Postman's GraphQL mode (query + variables). In GraphQL an error usually comes back with status 200 and the 'errors' list: that is why each request also validates 'data' and 'errors'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://countries.trevorblades.com" }
  ],
  "item": [
    {
      "name": "API-GQL-001 — Query a country by code (High)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query Country($code: ID!) {\n  country(code: $code) {\n    name\n    capital\n    currency\n  }\n}",
            "variables": "{\n  \"code\": \"AR\"\n}"
          }
        },
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns no errors', function () {",
              "    pm.expect(pm.response.json().errors).to.be.undefined;",
              "});",
              "pm.test('Returns Argentina with its capital', function () {",
              "    var country = pm.response.json().data.country;",
              "    pm.expect(country.name).to.eql('Argentina');",
              "    pm.expect(country.capital).to.eql('Buenos Aires');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-GQL-002 — Nonexistent country code returns null (Medium)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query Country($code: ID!) {\n  country(code: $code) {\n    name\n  }\n}",
            "variables": "{\n  \"code\": \"ZZ\"\n}"
          }
        },
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('The country is null', function () {",
              "    pm.expect(pm.response.json().data.country).to.be.null;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-GQL-003 — Nonexistent field returns a validation error (Medium)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query NonexistentField {\n  country(code: \"AR\") {\n    nonexistentField\n  }\n}",
            "variables": ""
          }
        },
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns an error that names the field', function () {",
              "    var errors = pm.response.json().errors;",
              "    pm.expect(errors).to.be.an('array').that.is.not.empty;",
              "    pm.expect(errors[0].message).to.include('nonexistentField');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
