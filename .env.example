# ╔═══════════════════════════════════════════════════════════════╗
# ║                                                               ║
# ║                      k 0 l m e n I A                          ║
# ║                Environment variables  ·  .env                 ║
# ║                                                               ║
# ╚═══════════════════════════════════════════════════════════════╝
#
#   ┌─ HOW TO USE THIS FILE ─────────────────────────────────────┐
#   │                                                            │
#   │   1)  Copy it to ".env":    cp .env.example .env           │
#   │   2)  Edit ONLY what you use (each block guides you).      │
#   │   3)  To enable a commented line, remove its "#".          │
#   │                                                            │
#   └────────────────────────────────────────────────────────────┘
#
#   LABELS YOU'LL SEE ON EACH VARIABLE
#   ----------------------------------
#     [REQUIRED]     ·  fill it in to get started
#     [OPTIONAL]     ·  only if you use that feature
#     [SECRET]       ·  token or password: NEVER pushed to the repo
#
#   GOLDEN RULES
#   ------------
#     •  ".env" is in .gitignore: it's never committed.
#     •  Use TEST / staging credentials, never production ones.
#     •  If a line is commented out (#), it's optional: leave it like that if you don't use it.
#     •  Lost? Each block says which agent or tool it's for.
#
#   THE MINIMUM TO GET STARTED
#   --------------------------
#     With just this you can already use most of the agents:
#         APP_URL        → the website you're going to test
#         APP_USER       → login user       (if the app requires it)
#         APP_PASSWORD   → login password   (if the app requires it)
#     Everything else is optional and you enable it when you need it.
#
#   FILE MAP
#   --------
#     1 · APPLICATION AND ACCESS           4 · SECURITY, STREAMING AND CAMERAS
#     2 · API AND k0lmena AUTOMATION       5 · OTHER AGENTS
#     3 · DATABASES                        6 · INTEGRATIONS (Jira, Azure, Xray…)
#
# ───────────────────────────────────────────────────────────────




# ╔═══════════════════════════════════════════════════════════════╗
# ║   1 · APPLICATION AND ACCESS                                  ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  APP UNDER TEST         ·  E2E runs with Playwright MCP
# └───────────────────────────────────────────────────────────────
#
# URL of the application under test: the only one. Used by the agents, the tools and k0lmena's web
# automation (which reads it as BASEURL; no need to define BASEURL separately).
#
# [REQUIRED]
APP_URL=https://your-test-app.com

# Login credentials (only if the app requires them).
# [OPTIONAL]  [SECRET]
APP_USER=your_user
APP_PASSWORD=your_password


# ┌───────────────────────────────────────────────────────────────
# │  SAVED SESSION          ·  npm run login
# └───────────────────────────────────────────────────────────────
#
# npm run login opens the browser, you log in by hand and it saves the session in .auth/ (gitignored).
# SESSION decides whether k0lmena's web suites (npm test) and the agents' browser use it:
#   empty = not used | yes = .auth/session.json | <name> = .auth/session-<name>.json (npm run login -- --name <name>)
# Scenarios tagged @no-session always start without a session. The agents' browser picks up the change when Claude Code restarts.
#
# [OPTIONAL]
SESSION=
# Page where npm run login opens (APP_URL by default).  [OPTIONAL]
# LOGIN_URL=


# ┌───────────────────────────────────────────────────────────────
# │  PERMISSIONS BY ROLE    ·  permissions-tester agent
# └───────────────────────────────────────────────────────────────
#
# Roles to test (anonymous, with no session, is always tested). Without PERMISSIONS_ROLES, APP_USER/APP_PASSWORD is used as the "user" role.
# This whole block is [OPTIONAL].
# PERMISSIONS_ROLES=admin,operator,guest
#
# Per role (the name in uppercase, without accents and with _ instead of spaces):  [SECRET]
# PERMISSIONS_ADMIN_USER=
# PERMISSIONS_ADMIN_PASSWORD=
# Token to test the API endpoints with that role (Authorization: Bearer):  [OPTIONAL] [SECRET]
# PERMISSIONS_ADMIN_TOKEN=
# Login page (the start URL by default) and selectors, if the login isn't detected automatically:  [OPTIONAL]
# PERMISSIONS_LOGIN_URL=
# PERMISSIONS_SELECTOR_USER=
# PERMISSIONS_SELECTOR_PASSWORD=
# PERMISSIONS_SELECTOR_SUBMIT=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   2 · API AND AUTOMATION WITH k0lmena                         ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  API TESTING            ·  Newman (api-runner agent)
# └───────────────────────────────────────────────────────────────
#
# Token to authenticate the API requests (if your collection uses {{token}}).
# scripts/run_newman.py (api-runner agent) passes it as the collection's {{token}} variable.
# [OPTIONAL]  [SECRET]
# API_TOKEN=


# ┌───────────────────────────────────────────────────────────────
# │  k0lmena AUTOMATION     ·  tools/k0lmena
# └───────────────────────────────────────────────────────────────
#
# k0lmena reads THIS same .env (there's no other one). It also uses APP_USER, APP_PASSWORD and API_TOKEN from above.
# Almost everything here has a sensible default: change only what you need.  [OPTIONAL]

# Scenario filter (empty = all). E.g.: @US-001   |   @smoke and not @wip
TAGS=
# Parallel in web/api: empty or 0 = sequential | on = one worker per CPU | N = N workers
PARALLEL=

#  · · ·  Web (Playwright + Cucumber). The URL is APP_URL (above).  · · ·
BROWSER=chromium
HEADLESS=true
SLOWMO=0
REPORT_DIR=reports/web
# Evidence in the report (web and mobile):
#   TRACE: off | on | on-failure  (Playwright trace, to open in trace.playwright.dev)
#   VIDEO: off | on | on-failure  (full video of the run)
#   EVIDENCE: screenshot | both | off  (for each passing scenario: final screenshot, or screenshot + GIF of the walkthrough)
#             Empty = npm test asks at startup (in CI it uses "screenshot").
TRACE=on-failure
VIDEO=on-failure
EVIDENCE=
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
LOCALE=en-US
TIMEZONE=America/New_York

#  · · ·  Locator auto-healing: off | learn | heal | on  · · ·
K0LMENA_AUTO_HEALING=on
K0LMENA_AUTO_HEALING_FLUSH=debounced
K0LMENA_AUTO_HEALING_WRITE_PRETTY=0
K0LMENA_AUTO_HEALING_LOG=0
K0LMENA_AUTO_HEALING_CONSOLE=1
K0LMENA_AUTO_HEALING_HISTORY_PATH=.k0lmena/auto-healing/front-history.json
K0LMENA_AUTO_HEALING_MAX_CANDIDATES=12
K0LMENA_AUTO_HEALING_SNAPSHOT_TIMEOUT_MS=250
K0LMENA_AUTO_HEALING_CANDIDATE_TIMEOUT_MS=1500

#  · · ·  API (axios + Cucumber). The token is API_TOKEN (above).  · · ·
# API_BASEURL is the spec's server WITH its basePath (computed by python scripts/summarize_openapi.py <spec>):
# the endpoints in the .feature use the spec path as is ("/pet/{petId}"), without repeating /v2.
API_BASEURL=https://petstore.swagger.io/v2
# Authentication according to the spec's securityScheme (see the k0lmena-automation skill):
#   Bearer / OAuth2 -> API_TOKEN · apiKey (header or query) -> API_KEY (if missing, API_TOKEN is used) · basic -> API_USER and API_PASSWORD
# [OPTIONAL]  [SECRET]
# API_KEY=
# API_USER=
# API_PASSWORD=
# Maximum time for each API request, in ms (30000 by default):
# API_TIMEOUT_MS=
# GraphQL endpoint for the GraphQL steps (optional): relative to API_BASEURL or a full URL.
# Empty = API_BASEURL + /graphql
# GRAPHQL_URL=

#  · · ·  Mobile (WebdriverIO + Appium)  · · ·
# MOBILE_TARGET: device | emulator | browserstack     MOBILE_PLATFORM: Android | iOS
MOBILE_TARGET=emulator
MOBILE_PLATFORM=Android
MOBILE_DEVICE_NAME=emulator-5554
MOBILE_PLATFORM_VERSION=
# File inside tools/k0lmena/mobile/apps/ (or an absolute path)
MOBILE_APP=app.apk
# Only MOBILE_TARGET=device (comes from `adb devices`)
MOBILE_UDID=
# Only MOBILE_TARGET=browserstack (BROWSERSTACK_APP = bs://... of the uploaded app).  [SECRET]
BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BROWSERSTACK_APP=
BROWSERSTACK_BUILD=k0lmenIA

#  · · ·  Performance (npm run perf, performance-mapper agent)  · · ·
# The load and thresholds go in each script; k6 uses API_BASEURL / BASEURL and the API_TOKEN token. Optional:
#   PERF_VUS / PERF_DURATION: override the load of a k6 script in every run (e.g. 5 and 1m)
PERF_VUS=
PERF_DURATION=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   3 · DATABASES                                               ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  DATABASES              ·  data-verifier agent + DB steps
# └───────────────────────────────────────────────────────────────
#
# Named connections; the first one is the default. Engines: postgres | mysql | mariadb | sqlserver | mongodb
# Per connection: DB_<NAME>_URL (optional, replaces host/port/database/user/password) or HOST, PORT, DATABASE, USER, PASSWORD.
# Security: read-only by default. WRITE=yes allows writing with explicit confirmation;
# PRODUCTION=yes blocks all writes. Recommended: a database user with read-only permissions.
# This whole block is [OPTIONAL]  [SECRET].
DB_CONNECTIONS=
# DB_MAIN_ENGINE=postgres
# DB_MAIN_HOST=localhost
# DB_MAIN_PORT=5432
# DB_MAIN_DATABASE=
# DB_MAIN_USER=
# DB_MAIN_PASSWORD=
# SSL: no | yes (encrypts and verifies the server certificate) | no-verify (accepts self-signed
#      certificates: test environments only). With your own CA, DB_MAIN_SSL_CA=path/ca.pem
# DB_MAIN_SSL=no
# DB_MAIN_WRITE=no
# DB_MAIN_PRODUCTION=no
# Optional: DB_MAX_ROWS=50 (rows the CLI shows) · DB_TIMEOUT_MS=30000 · DB_WAIT_MS=5000 (step retries)
#           DB_SENSITIVE_COLUMNS=ssn,phone (added to password, token, key, hash, card… which are already masked)




# ╔═══════════════════════════════════════════════════════════════╗
# ║   4 · SECURITY, STREAMING AND CAMERAS                         ║
# ╚═══════════════════════════════════════════════════════════════╝
#
#   /!\  IMPORTANT: everything below is ONLY for your OWN devices
#        or sites, or with WRITTEN authorization from their owner.
#        The "_AUTHORIZED_*" lists are the safety barrier:
#        if something isn't on the list, it is NOT tested.


# ┌───────────────────────────────────────────────────────────────
# │  WEB SECURITY           ·  security-analyst, web-pentester (OWASP ZAP in Docker)
# └───────────────────────────────────────────────────────────────
#
# Only the sites on this list are scanned. Comma-separated; each URL covers its subpaths.
# [OPTIONAL]  (required only if you're going to use these agents)
SECURITY_AUTHORIZED_URLS=
# ZAP image (ghcr.io/zaproxy/zaproxy:stable by default):
# ZAP_IMAGE=
# ACTIVE pentest (web-pentester agent): the active scan is intrusive (it sends attacks and can
# modify data). Set "yes" ONLY for your own site or one with written authorization, never in
# production without that permission. Empty = only the passive scan is allowed.
# PENTEST_AUTHORIZED=


# ┌───────────────────────────────────────────────────────────────
# │  STREAMING AND PLAYBACK ·  streaming-tester agent (ffprobe/ffmpeg)
# └───────────────────────────────────────────────────────────────
#
# Only the sources on this list are tested. Comma-separated.
# E.g.: rtsp://cam.local/stream, https://cdn.my-app.com/live/
# [OPTIONAL]
STREAMING_AUTHORIZED_SOURCES=
# Thresholds (otherwise: 10 fps, 3 s to connect, 4 s to start, 4 s GOP):
# STREAMING_MIN_FPS=10
# STREAMING_LATENCY_WARN_S=3
# STREAMING_TTFF_WARN_S=4
# STREAMING_GOP_WARN_S=4


# ┌───────────────────────────────────────────────────────────────
# │  ONVIF CONTROL          ·  onvif-tester, recording-verifier (onvif-zeep)
# └───────────────────────────────────────────────────────────────
#
# Only the cameras on this list are tested. Host or host:port, comma-separated.
# E.g.: 192.168.1.50, camera.local:80
# [OPTIONAL]
ONVIF_AUTHORIZED_HOSTS=
# TEST credentials for the camera (never production ones without authorization):  [SECRET]
# ONVIF_USER=
# ONVIF_PASSWORD=
# Site standard: flags cameras that differ. Clock drift warning in seconds (60):
# ONVIF_EXPECTED_TZ=
# ONVIF_EXPECTED_NTP=
# ONVIF_EXPECTED_FIRMWARE=
# ONVIF_CLOCK_DRIFT_WARN_S=60
# Expected recording retention, in days (recording-verifier agent):
# RECORDINGS_RETENTION_DAYS=30
# Seconds to wait for live events (pull-point) by default if --events isn't passed (0 = no):
# ONVIF_EVENTS_WAIT_S=0


# ┌───────────────────────────────────────────────────────────────
# │  CAMERA SECURITY        ·  camera-security-analyst (passive scan)
# └───────────────────────────────────────────────────────────────
#
# Only the cameras on this list are analyzed. IP or IP:port, comma-separated.
# E.g.: 192.168.1.50, 192.168.1.51
# [OPTIONAL]
AUTHORIZED_CAMERAS=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   5 · OTHER AGENTS                                            ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  SALESFORCE             ·  salesforce-tester agent (sf CLI + salesforce connector)
# └───────────────────────────────────────────────────────────────
#
# Tests a Salesforce org (SANDBOX). First you have to install the CLI and authorize the org:
#   npm install --global @salesforce/cli
#   sf org login web --alias my-qa-sandbox --instance-url https://test.salesforce.com
# Only the orgs on this list are surveyed (aliases, comma-separated), never production.
# [OPTIONAL]
SALESFORCE_AUTHORIZED_ORGS=
# The default org if --org isn't passed (and the one the salesforce connector uses): an alias from the list.
# SALESFORCE_ORG=my-qa-sandbox
# Objects to review the sharing model (OWD), comma-separated. Empty = standard + custom.
# SALESFORCE_OBJECTS=Account,Opportunity,Order__c


# ┌───────────────────────────────────────────────────────────────
# │  WALLETS AND PAYMENTS   ·  wallet-tester agent
# └───────────────────────────────────────────────────────────────
#
# It doesn't need its own variables: it uses the wallet API (API_BASEURL and the token from section 2),
# the database to verify balances (section 3) and the provider's TEST CARDS (Stripe, Mercado
# Pago, Adyen…). Always against a TEST / sandbox environment: never real money or cards.


# ┌───────────────────────────────────────────────────────────────
# │  E-COMMERCE             ·  shopify-tester and wordpress-tester agents
# └───────────────────────────────────────────────────────────────
#
# Only the stores on this list are surveyed (storefront URL, comma-separated). Ideally
# development or staging stores. E.g.: https://my-store.myshopify.com, https://staging.mystore.com
# [OPTIONAL]
ECOMMERCE_AUTHORIZED_URLS=
#
# --- Shopify (npm run shopify) ---
# Default storefront if --store isn't passed.
# SHOPIFY_STORE_URL=https://my-store.myshopify.com
# Admin API (optional): myshopify domain and the token of a custom app with ONLY read_* scopes
# (read_products, read_inventory, read_themes, read_shipping, read_markets, read_discounts, read_locations).
# Without a token only the public storefront is surveyed.
# SHOPIFY_STORE=my-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# Theme code for Theme Check (--theme-check, requires npm install --global @shopify/cli).
# SHOPIFY_THEME_PATH=C:/projects/my-theme
# Storefront password if the store is protected (the agent uses it with Playwright).
# SHOPIFY_STOREFRONT_PASSWORD=
#
# --- WordPress / WooCommerce (npm run wordpress) ---
# Default site if --site isn't passed.
# WORDPRESS_URL=https://staging.mystore.com
# WooCommerce REST API (optional): key with READ permission
# (WooCommerce → Settings → Advanced → REST API). Without a key only the public parts are surveyed.
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
# WP-CLI (optional, --wp-cli): the path of the local installation or the full command if it runs in Docker.
# WORDPRESS_LOCAL_PATH=C:/www/mystore
# WORDPRESS_WP_CLI=docker compose exec -T wordpress wp
#
# --- PrestaShop (npm run prestashop) ---
# Default store if --store isn't passed.
# PRESTASHOP_URL=https://staging.mystore.com
# Webservice API (optional): key with READ-ONLY permission (Advanced Parameters → Webservice).
# Enable at least read access to: configurations, products, stock_availables, carriers, zones, currencies,
# languages, cart_rules and shops. Without a key only the public storefront is surveyed.
# PRESTASHOP_WEBSERVICE_KEY=
# Local installation (optional, --local): to read the version and whether developer mode was left on.
# PRESTASHOP_LOCAL_PATH=C:/www/mystore
#
# --- VTEX (npm run vtex) ---
# Default storefront if --store isn't passed (authorized in ECOMMERCE_AUTHORIZED_URLS).
# VTEX_URL=https://www.my-store.com
# VTEX account (if it can't be inferred from the *.myvtex.com / *.vtexcommercestable.com.br URL).
# VTEX_ACCOUNT=myaccount
# Workspace to test (master by default; for QA use your own workspace, e.g. qa).
# VTEX_WORKSPACE=master
# Admin APIs (optional): app with READ-ONLY roles (License Manager → Application Keys).
# VTEX_APP_KEY=
# VTEX_APP_TOKEN=
# Default sales channel for the public catalog (optional).
# VTEX_SALES_CHANNEL=1


# ┌───────────────────────────────────────────────────────────────
# │  EMAILS                 ·  email-verifier agent + email steps (Mailpit)
# └───────────────────────────────────────────────────────────────
#
# Mailpit test mailbox (tools/mailpit/README.md). The app in the test environment sends
# its emails over SMTP to Mailpit (port 1025) and the address of its web UI/API goes here.
# [OPTIONAL]
MAILPIT_URL=http://localhost:8025
# Only if your Mailpit asks for a user and password (--ui-auth):  [SECRET]
# MAILPIT_USER=
# MAILPIT_PASSWORD=
# Seconds the "an email arrives at ..." step waits (30 by default):
# EMAIL_TIMEOUT_S=30


# ┌───────────────────────────────────────────────────────────────
# │  APP REPOSITORY         ·  project-documenter agent (read-only)
# └───────────────────────────────────────────────────────────────
#
# The project-documenter reads the app repository (README and docs, rules in the code, messages,
# API contracts, PRs and commits for each story) through its provider's MCP connector, READ-ONLY,
# and leaves what it finds in input/documentation/ (not versioned) for the rest of the agents.
# This whole block is [OPTIONAL].
#   github      → "github" connector       (npm run connector -- activate github)  · uses GITHUB_TOKEN
#   gitlab      → "gitlab" connector       (npm run connector -- activate gitlab)  · uses GITLAB_URL / GITLAB_TOKEN
#   azure-repos → "azure-devops" connector (already uses ADO_ORGANIZATION / ADO_PAT; the PAT needs Code: Read)
#   bitbucket   → "atlassian" connector (Bitbucket Cloud), with ATLASSIAN_MCP_AUTHENTICATION=token
# REPO_PROVIDER=github
# Repositories, comma-separated (for example front end and back end):
#   github: owner/repo · gitlab: group/project · azure-repos: project/repo · bitbucket: workspace/repo
# REPO_NAME=my-company/my-web-app,my-company/my-app-api
# Branch to document (empty = the repository's default branch)
# REPO_BRANCH=main
# Path to a local clone of the same repository. If set, the code is read from there (faster
# and without spending connector tokens); PRs and commits are still read through the connector.
# REPO_LOCAL_PATH=
#
# GitHub: READ-ONLY fine-grained personal access token (Contents, Pull requests, Issues and
# Metadata: Read-only) at https://github.com/settings/personal-access-tokens
# The connector uses the official remote server (api.githubcopilot.com) in read-only mode.
# GitHub Enterprise Server isn't supported by the remote server (see CONNECTORS.md).  [SECRET]
# GITHUB_TOKEN=
# Server toolsets (context,repos,issues,pull_requests by default):
# GITHUB_TOOLSETS=
#
# GitLab: GitLab.com or self-managed / Dedicated 19.5 or later (official MCP server at /api/v4/mcp).
# GITLAB_URL=https://gitlab.com
# Without a token, you authorize with your account (OAuth) from /mcp. With a token: a fine-grained
# personal access token with the "MCP tool" resource and the Execute permission (classic tokens are rejected).  [SECRET]
# GITLAB_TOKEN=
# Toolsets (meta,core,merge_requests,work_items,repository,wikis by default):
# GITLAB_TOOLSETS=


# ┌───────────────────────────────────────────────────────────────
# │  NOTIFICATIONS          ·  Slack and Microsoft Teams (scripts/notify.py)
# └───────────────────────────────────────────────────────────────
#
# Used by npm test, monitoring and the closure report, when requested or configured.
# They're [SECRET]: whoever has the URL can post to the channel.
# Slack: Incoming Webhook of a Slack app (https://hooks.slack.com/services/...)
# SLACK_WEBHOOK_URL=
# Teams: webhook of a Teams Workflows flow, template "Post to a channel when a webhook request is
# received" (the Office 365 connectors' Incoming Webhooks are retired)
# TEAMS_WEBHOOK_URL=


# ┌───────────────────────────────────────────────────────────────
# │  SYNTHETIC MONITORING   ·  npm run monitor
# └───────────────────────────────────────────────────────────────
#
# See tools/k0lmena/tools/monitoring/README.md .  [OPTIONAL]
# URLs to check, comma-separated (or input/monitoring.json with finer-grained checks). GET or HEAD only.
# MONITORING_URLS=https://your-app.com,https://your-app.com/login
# Link that goes with the notification (for example, the CI run):
# MONITORING_LINK=


# ┌───────────────────────────────────────────────────────────────
# │  RUN HISTORY            ·  all tools
# └───────────────────────────────────────────────────────────────
#
# How many runs each tool keeps in history/ to compare them (5 by default):
# RUN_HISTORY=5


# ┌───────────────────────────────────────────────────────────────
# │  TRANSLATION, LANGUAGES ·  translation-analyst agent
# └───────────────────────────────────────────────────────────────
#
# Languages or regions to review, comma-separated (BCP 47 codes). The first one is the reference.  [OPTIONAL]
# TRANSLATOR_LANGUAGES=en-US,es-AR,pt-BR
# How the language is switched on the site (by default it tries ?lang=, the /xx/ path and the
# Accept-Language header). {language} and {short_language} are replaced: https://my-app.com/{short_language}/
# TRANSLATOR_LANGUAGE_URL=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   6 · INTEGRATIONS                                            ║
# ║       project management · design · test management           ║
# ╚═══════════════════════════════════════════════════════════════╝
#
#   Each team uses its own tools: fill in and uncomment ONLY the blocks you use.
#   Jira + Confluence come active ("atlassian" connector); the rest are ready, commented out.
#
#   MCP connectors: "playwright", "playwright-headless" and "atlassian" come active. The others
#   (Azure DevOps, Figma, GitHub, GitLab, Linear, ClickUp, monday.com, Asana, Trello, Notion, YouTrack,
#   Shortcut, QMetry, AIO Tests, k0lmenaTMT, Appium) each person activates with:
#       npm run connector -- activate azure-devops
#   and restarting Claude Code. No secrets in any versioned file: the values come from this .env.
#   Full guide: CONNECTORS.md · scripts/management/README.md


# ┌───────────────────────────────────────────────────────────────
# │  JIRA AND CONFLUENCE    ·  Atlassian Cloud      [ ✓ ACTIVE BY DEFAULT ]
# └───────────────────────────────────────────────────────────────
#
# "atlassian" MCP connector: stories, comments, epics, linked issues and Confluence pages.
# It also gives access to Bitbucket Cloud (the app repository), but only with ATLASSIAN_MCP_AUTHENTICATION=token
# and an API token with the Bitbucket scopes (see CONNECTORS.md).
# Connector authentication:
#   oauth  (default) you authorize with your account the first time, from /mcp > atlassian. No token used.
#   token  uses JIRA_EMAIL + JIRA_API_TOKEN. An Atlassian admin has to enable it in
#          Atlassian Administration > Rovo > Rovo MCP server > Authentication.
ATLASSIAN_MCP_AUTHENTICATION=oauth
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
# Personal API token (Xray Cloud also uses it to link test cases to stories):  [SECRET]
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Instead of the personal token: API key of a service account (sent as Bearer).  [OPTIONAL] [SECRET]
# ATLASSIAN_API_KEY=


# ┌───────────────────────────────────────────────────────────────
# │  AZURE DEVOPS           ·  Boards, Test Plans and Wiki
# └───────────────────────────────────────────────────────────────
#
# "azure-devops" MCP connector: stories, comments, Wiki and test cases in Azure Test Plans.  [OPTIONAL]
# Organization: just the name, the one in https://dev.azure.com/<organization>
# ADO_ORGANIZATION=
# Personal Access Token (User settings > Personal access tokens). Minimum scopes:  [SECRET]
#   Work Items (Read & write), Test Management (Read & write), Project and Team (Read),
#   Wiki (Read) and Code (Read) for code search and the repository (project-documenter).
# ADO_PAT=
# Default project and team (if missing, they're specified in each request):
# ADO_PROJECT=
# ADO_TEAM=
# Optional:
#   ADO_AUTHENTICATION: pat (default, uses ADO_PAT) | interactive (login in the browser) | azcli ("az login" session)
#   ADO_TENANT: Microsoft Entra tenant (only interactive or azcli)
#   ADO_DOMAINS: areas that are enabled (default: core work work-items repositories test-plans wiki search)
# ADO_AUTHENTICATION=pat
# ADO_TENANT=
# ADO_DOMAINS=core work work-items repositories test-plans wiki search


# ┌───────────────────────────────────────────────────────────────
# │  FIGMA                  ·  designs
# └───────────────────────────────────────────────────────────────
#
# "figma" (remote) or "figma-desktop" (desktop app) MCP connectors. They don't use variables:
# you authorize them with your Figma account from /mcp. Requires a Full or Dev seat.


# ┌───────────────────────────────────────────────────────────────
# │  OTHER PROJECT MANAGEMENT TOOLS  ·  stories, tasks, documentation
# └───────────────────────────────────────────────────────────────
#
# If your team doesn't use Jira or Azure DevOps, the stories are read just the same from these tools with
# their official MCP connector (read-only for what the agents need). Activate only the one you use:
#     npm run connector -- activate linear      (or clickup, monday, asana, trello, notion, youtrack, shortcut)
# The ones marked "OAuth" don't use variables: the first time, you authorize with your account from /mcp.
# All the keys in this block are [OPTIONAL]  [SECRET].
#
# Linear · OAuth. Instead of OAuth: a read-only API key (in your account, "Security & access" >
# Personal API keys, with Read permission). The connector uses the read-only endpoint.
# LINEAR_API_KEY=
#
# ClickUp · OAuth only (ClickUp doesn't accept API tokens on its MCP server).
# monday.com · OAuth. Optional: personal API token (Avatar > Developers > My access tokens).
# MONDAY_API_TOKEN=
#
# Asana · the V2 server doesn't accept automatic registration: create an "MCP app" at
# https://app.asana.com/0/my-apps with the redirect URL http://localhost:8080/callback and copy its data here.
# The secret is stored in the system keychain when the connector is activated (it isn't left in any file).
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
#
# Trello · OAuth only (you choose the workspaces on the consent screen).
# Notion · OAuth only (pages, databases and wikis you share with the connection).
# Shortcut · OAuth only.
#
# YouTrack (Cloud or Server) · site URL and a permanent token (Profile > Account Security > Tokens,
# with the YouTrack scope). If you change the URL, activate the connector again.
# YOUTRACK_URL=https://my-company.youtrack.cloud
# YOUTRACK_TOKEN=
#
# GitHub Issues/Projects and GitLab Issues/work items: read by the "github" and "gitlab" connectors
# ("App repository" block, in section 5).


# ┌───────────────────────────────────────────────────────────────
# │  TEST MANAGEMENT        ·  test-manager and results-publisher agents
# └───────────────────────────────────────────────────────────────
#
# Xray, QTM4J and AIO are integrated with scripts/management/management.py (folders, test cases, links,
# cycles and results with evidence). Azure DevOps goes through its MCP connector (block above).
# [OPTIONAL]
# MANAGEMENT_TOOL: xray-cloud | xray-dc | qtm4j | aio
# MANAGEMENT_PROJECT: Jira project key (e.g. PROJ)
# MANAGEMENT_TOOL=
# MANAGEMENT_PROJECT=

#  · · ·  Xray Cloud  · · ·   [SECRET]
# No official MCP: scripts/management integrates it. Also uses JIRA_BASE_URL, JIRA_EMAIL and JIRA_API_TOKEN.
# Xray API key: Xray > Global Settings > API Keys
# XRAY_CLOUD_CLIENT_ID=
# XRAY_CLOUD_CLIENT_SECRET=
# Region (optional): https://us.xray.cloud.getxray.app | https://eu.xray.cloud.getxray.app | https://au.xray.cloud.getxray.app
# XRAY_CLOUD_URL=https://xray.cloud.getxray.app

#  · · ·  Xray Server / Data Center  · · ·   [SECRET]
# Your Jira URL + Personal Access Token (or user and password)
# XRAY_DC_URL=https://jira.your-company.com
# XRAY_DC_TOKEN=
# XRAY_DC_USER=
# XRAY_DC_PASSWORD=

#  · · ·  QMetry for Jira Cloud (QTM4J)  · · ·   [SECRET]
# Used by scripts/management and the "qtm4j" MCP connector. Open API key: QMetry > Configuration > Open API
# Region: https://qtmcloud.qmetry.com (US) | https://syd-qtmcloud.qmetry.com (AU) | https://eu-qtm4j-cloud.qmetry.com (EU)
# QTM4J_API_KEY=
# QTM4J_BASE_URL=https://qtmcloud.qmetry.com
# Only for the MCP connector's automation tools (optional):
# QTM4J_AUTOMATION_API_KEY=

#  · · ·  QMetry Test Management (standalone)  · · ·   [SECRET]
# "qmetry" MCP connector (SmartBear's official server). QMetry Open API key.
# QMETRY_API_KEY=
# QMETRY_BASE_URL=https://testmanagement.qmetry.com

#  · · ·  AIO Tests (Jira Cloud)  · · ·   [SECRET]
# Used by scripts/management and the "aio-tests" MCP connector. API token: AIO Tests > My Settings > API Token
# AIO_API_TOKEN=
# MCP server URL (unique per tenant): AIO Tests > My Settings > MCP Authorization
# AIO_MCP_URL=https://tcms-prod-us.aiojiraapps.com/aiotcms-mcp/v1/<your-tenant-id>/mcp

#  · · ·  k0lmenaTMT  · · ·   [SECRET]
# "k0lmena-tmt" MCP connector. Personal token (kolm_pat_...) generated in k0lmenaTMT.
# K0LMENA_TMT_TOKEN=
# The default URL is http://localhost:4000/api/v1/mcp. For a different one, define it here BEFORE
# "npm run connector -- activate k0lmena-tmt" (if you change it, activate it again) or in the environment:
# K0LMENA_TMT_URL=http://localhost:4000/api/v1/mcp


# ┌───────────────────────────────────────────────────────────────
# │  APPIUM                 ·  mobile-mapper
# └───────────────────────────────────────────────────────────────
#
# "appium-mcp" MCP connector: path to the Android SDK, if it isn't in the environment.  [OPTIONAL]
# ANDROID_HOME=


# ┌───────────────────────────────────────────────────────────────
# │  FINE-TUNING scripts/management  ·  see scripts/management/README.md
# └───────────────────────────────────────────────────────────────
#
# All [OPTIONAL]: you'll almost never need to touch it.
# MANAGEMENT_ATTACHMENT_LIMIT_MB=   size cap per evidence file (Xray Server/DC: 10 by default)
# MANAGEMENT_SEND_PRIORITY=0   don't send priority when creating test cases (if your Jira uses other names)
# MANAGEMENT_PRIORITIES={"Critical":"Highest","High":"High","Medium":"Medium","Low":"Low"}
# XRAY_LINK_CASE=Test          case-story link type (Server/DC: detected automatically)
# XRAY_LINK_CYCLE=Relates      run-story link type
# XRAY_LINK_INVERT=1           if the link ends up reversed (the story should say "is tested by")
# XRAY_STATUSES / QTM4J_STATUSES / AIO_STATUSES   JSON to map custom statuses, e.g. {"blocked":"BLOCKED"}
# AIO_CASE_STATUS=Published    status the test cases are created with in AIO
