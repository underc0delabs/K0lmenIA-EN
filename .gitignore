# Don't version what the agents generate, but keep the empty folders
/output/**
!/output/
!/output/**/
!/output/**/.gitkeep

# Application logs for the log-analyst: they may contain personal data, not versioned
/input/logs/*
!/input/logs/.gitkeep

# Project documentation gathered by the project-documenter (code, stories, comments and the
# client's internal pages): not versioned. Regenerate it with the agent.
/input/documentation/*
!/input/documentation/.gitkeep

# Operating system
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Node (in case tools are added later)
node_modules/
npm-debug.log*

# Environment variables / secrets (MCP tokens, etc.)
.env
.env.local

# Sessions saved with npm run login (app cookies: equivalent to a password)
.auth/

# Python
__pycache__/
*.pyc
.venv/
venv/

# MCP: DO NOT commit secrets. .mcp.json is versioned without secrets: tokens are read from .env
# by the scripts in scripts/mcp/ (see CONNECTORS.md), never with the real value in the file.

# Personal Claude Code permissions (not shared)
.claude/settings.local.json

# Playwright MCP default folder (loose screenshots/traces)
.playwright-mcp/

# Loose logs
*.log

# Agent eval results (scripts/evaluate_agents.py): regenerated
/evals/results/
