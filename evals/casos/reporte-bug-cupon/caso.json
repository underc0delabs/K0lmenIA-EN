{
  "agente": "generador-reportes-bug",
  "descripcion": "Observación desordenada de un bug (cupón que se aplica varias veces). Faltan la contraseña, la evidencia y la versión: el reporte tiene que seguir la plantilla y marcarlo, sin inventarlo.",
  "pedido": "Usá el agente generador-reportes-bug para armar el reporte de bug de input/bugs/observacion-cupon.md.",
  "insumos": [
    {"desde": "insumos/observacion-cupon.md", "hacia": "input/bugs/observacion-cupon.md"}
  ],
  "presupuesto_usd": 1,
  "umbral": 80,
  "chequeos": [
    {"id": "archivo", "tipo": "existe", "descripcion": "Deja el reporte en output/reportes-bug/BUG-XXX.md",
     "archivos": ["output/reportes-bug/BUG-*.md"], "peso": 2},
    {"id": "campos", "tipo": "orden", "descripcion": "Tiene todos los campos de la plantilla, en orden",
     "archivos": ["output/reportes-bug/BUG-*.md"], "peso": 3,
     "patrones": ["\\*\\*ID:\\*\\*", "\\*\\*T[íi]tulo:\\*\\*", "\\*\\*Historia:\\*\\*", "\\*\\*Estado:\\*\\*", "\\*\\*Descripci[óo]n:\\*\\*",
                  "\\*\\*Precondiciones:\\*\\*", "\\*\\*Test Data:\\*\\*", "\\*\\*Pasos de reproducci[óo]n:\\*\\*", "\\*\\*Resultado Actual:\\*\\*",
                  "\\*\\*Resultado Esperado:\\*\\*", "\\*\\*Evidencia:\\*\\*", "\\*\\*Criticidad / Severidad:\\*\\*", "\\*\\*Prioridad:\\*\\*",
                  "\\*\\*Browser:\\*\\*", "\\*\\*Ambiente:\\*\\*"]},
    {"id": "datos", "tipo": "contiene", "descripcion": "Usa los datos de la observación (cupón, ambiente, navegador, montos)",
     "archivos": ["output/reportes-bug/BUG-*.md"], "patrones": ["DESC10", "staging", "chrome", "10\\.?000", "7\\.?000|30\\s*%"]},
    {"id": "estado", "tipo": "contiene", "descripcion": "Un bug nuevo nace Abierto",
     "archivos": ["output/reportes-bug/BUG-*.md"], "patrones": ["\\*\\*Estado:\\*\\*\\s*`?Abierto"]},
    {"id": "esperado", "tipo": "contiene", "descripcion": "El resultado esperado dice que el cupón se aplica una sola vez",
     "archivos": ["output/reportes-bug/BUG-*.md"], "patrones": ["Resultado Esperado:\\*\\*.{0,400}(una (sola )?vez|solo (el )?10\\s*%|no (se )?(vuelve|vuelva) a (aplicar|descontar)|no acumul)"], "peso": 2},
    {"id": "faltante", "tipo": "contiene", "descripcion": "Marca la información faltante (versión, evidencia o contraseña) en vez de inventarla",
     "archivos": ["output/reportes-bug/BUG-*.md"], "patrones": ["Informaci[óo]n faltante|Falta informaci[óo]n"], "peso": 2},
    {"id": "no-inventa-password", "tipo": "no_contiene", "descripcion": "No inventa una contraseña",
     "archivos": ["output/reportes-bug/BUG-*.md"],
     "patrones": ["Password:\\s*`?(?!\\s*$)(?![^\\n]*(falta|no (se )?(indic|inform|especific|provey|dio)|sin dato|n/a|desconocid|a confirmar|pendiente|—|-\\s*$|\\[|\\(|_))[^\\n]{3,}"], "peso": 2},
    {"id": "no-inventa-version", "tipo": "no_contiene", "descripcion": "No inventa una versión de la app o del navegador",
     "archivos": ["output/reportes-bug/BUG-*.md"],
     "patrones": ["(Versi[óo]n:\\*\\*|Chrome)\\s*v?\\d+\\.\\d+"]}
  ]
}
