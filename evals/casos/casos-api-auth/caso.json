  "pedido": "Usá el agente generador-casos-api para generar los casos de API de input/api/auth-endpoints.md.",
  "insumos": [
    {"desde": "repo:input/api/auth-endpoints.md", "hacia": "input/api/auth-endpoints.md"}
  ],
  "presupuesto_usd": 2,
  "umbral": 80,
  "chequeos": [
    {"id": "archivo", "tipo": "existe", "descripcion": "Deja los casos en output/casos-api/casos-api-<tema>.md",
     "archivos": ["output/casos-api/casos-api-*.md"], "peso": 2},
    {"id": "ids", "tipo": "conteo", "descripcion": "Al menos 8 casos con ID CP-API-XXX",
     "archivos": ["output/casos-api/casos-api-*.md"], "patron": "CP-API-\\d{3}", "min": 8, "distintos": true, "peso": 2},
    {"id": "endpoints", "tipo": "contiene", "descripcion": "Cubre los endpoints del contrato",
     "archivos": ["output/casos-api/casos-api-*.md"], "patrones": ["/auth/login", "/auth/forgot-password"]},
    {"id": "codigos", "tipo": "contiene", "descripcion": "Cubre cada código de respuesta documentado (200, 400, 401, 423)",
     "archivos": ["output/casos-api/casos-api-*.md"], "patrones": ["\\b200\\b", "\\b400\\b", "\\b401\\b", "\\b423\\b"], "peso": 3},
    {"id": "bloqueo", "tipo": "contiene", "descripcion": "Prueba el bloqueo por 3 intentos fallidos",
     "archivos": ["output/casos-api/casos-api-*.md"], "patrones": ["(3|tres)\\s*intentos|bloque"]},
    {"id": "no-revela", "tipo": "contiene", "descripcion": "Prueba que forgot-password no revela si el email existe",
     "archivos": ["output/casos-api/casos-api-*.md"], "patrones": ["(no (revela|indica|informa)|mism[ao] (respuesta|mensaje)|inexistente|no registrad)"]},
    {"id": "json", "tipo": "conteo", "descripcion": "Los bodies van en bloques ```json",
     "archivos": ["output/casos-api/casos-api-*.md"], "patron": "```json", "min": 3},
    {"id": "tablas", "tipo": "tablas_normalizadas", "descripcion": "Pasa las tablas por formatear_tablas.py",
     "archivos": ["output/casos-api/casos-api-*.md"]}
  ]
}
